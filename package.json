{
  "name": "repository-rate-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "test": "jest",
    "lint": "expo lint",
    "format": "prettier --write .",
